{
  "name": "vscode-devgotchi",
  "displayName": "DevGotchi - Your Virtual Developer",
  "description": "A cyberpunk RPG for your coding sessions. Level up, earn XP, and fight off burnout as a living developer avatar tracks your focus, energy, and motivation in real time.",
  "version": "2.4.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "icon.png",
  "publisher": "johnfacey",
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "devgotchi.openPanel",
        "title": "Open Developer Panel",
        "category": "DevGotchi"
      },
      {
        "command": "devgotchi.startFocusSprint",
        "title": "Start Focus Sprint (Pomodoro)",
        "category": "DevGotchi"
      },
      {
        "command": "devgotchi.cancelFocusSprint",
        "title": "Cancel Focus Sprint",
        "category": "DevGotchi"
      },
      {
        "command": "devgotchi.exportStatsCard",
        "title": "Export Stats Card",
        "category": "DevGotchi"
      },
      {
        "command": "devgotchi.openSettings",
        "title": "Open Settings",
        "category": "DevGotchi"
      },
      {
        "command": "devgotchi.exportProgress",
        "title": "Export Progress",
        "category": "DevGotchi"
      },
      {
        "command": "devgotchi.importProgress",
        "title": "Import Progress",
        "category": "DevGotchi"
      },
      {
        "command": "devgotchi.toggleVacationMode",
        "title": "Toggle Vacation Mode",
        "category": "DevGotchi"
      },
      {
        "command": "devgotchi.sendFeedback",
        "title": "Send Feedback / Report a Bug",
        "category": "DevGotchi"
      },
      {
        "command": "devgotchi.toggleTeamMode",
        "title": "Toggle Team Mode",
        "category": "DevGotchi"
      },
      {
        "command": "devgotchi.openTeamView",
        "title": "Open Team View",
        "category": "DevGotchi"
      }
    ]
  }, "maintainers": [
    "John Facey"
  ],
    "repository": {
    "type": "git",
    "url": "https://github.com/johnfacey/vscode-devgotchi.git"
  },
    "keywords": [
    "tamagotchi",
    "tamogotchi",
    "gamification",
    "productivity",
    "rpg",
    "focus",
    "burnout",
    "pomodoro",
    "streak",
    "motivational",
    "game"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "package": "npx vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "eslint": "^8.47.0",
    "typescript": "^5.1.6"
  }
}
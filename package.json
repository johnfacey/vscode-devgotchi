{
  "name": "vscode-devgotchi",
  "displayName": "DevGotchi — Gamify Coding: Pomodoro Timer, XP & Achievements",
  "description": "Turn VS Code into a cyberpunk RPG. Your living developer avatar tracks focus, energy & motivation in real time — earn XP for every save and commit, run Pomodoro focus sprints, battle real bosses tied to your repo state, and protect your streak. Free forever. No telemetry, no account.",
  "version": "2.8.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "icon.png",
  "publisher": "johnfacey",
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "devgotchi.openPanel",
        "title": "Open Developer Panel",
        "category": "DevGotchi"
      },
      {
        "command": "devgotchi.startFocusSprint",
        "title": "Start Focus Sprint (Pomodoro)",
        "category": "DevGotchi"
      },
      {
        "command": "devgotchi.cancelFocusSprint",
        "title": "Cancel Focus Sprint",
        "category": "DevGotchi"
      },
      {
        "command": "devgotchi.exportStatsCard",
        "title": "Export Stats Card",
        "category": "DevGotchi"
      },
      {
        "command": "devgotchi.openWeeklyRecap",
        "title": "Share Weekly Recap",
        "category": "DevGotchi"
      },
      {
        "command": "devgotchi.openYearlyRecap",
        "title": "Share Year in Code Wrapped",
        "category": "DevGotchi"
      },
      {
        "command": "devgotchi.openSettings",
        "title": "Open Settings",
        "category": "DevGotchi"
      },
      {
        "command": "devgotchi.exportProgress",
        "title": "Export Progress",
        "category": "DevGotchi"
      },
      {
        "command": "devgotchi.importProgress",
        "title": "Import Progress",
        "category": "DevGotchi"
      },
      {
        "command": "devgotchi.exportTimesheet",
        "title": "Export Timesheet (billable hours CSV)",
        "category": "DevGotchi"
      },
      {
        "command": "devgotchi.importQuestPack",
        "title": "Import Quest Pack from File",
        "category": "DevGotchi"
      },
      {
        "command": "devgotchi.importQuestPackFromUrl",
        "title": "Import Quest Pack from URL",
        "category": "DevGotchi"
      },
      {
        "command": "devgotchi.toggleVacationMode",
        "title": "Toggle Vacation Mode",
        "category": "DevGotchi"
      },
      {
        "command": "devgotchi.sendFeedback",
        "title": "Send Feedback / Report a Bug",
        "category": "DevGotchi"
      },
      {
        "command": "devgotchi.openSponsors",
        "title": "Support DevGotchi on GitHub Sponsors",
        "category": "DevGotchi"
      },
      {
        "command": "devgotchi.prestige",
        "title": "Prestige (reset Level for a permanent XP badge)",
        "category": "DevGotchi"
      },
      {
        "command": "devgotchi.toggleTeamMode",
        "title": "Toggle Team Mode",
        "category": "DevGotchi"
      },
      {
        "command": "devgotchi.openTeamView",
        "title": "Open Team View",
        "category": "DevGotchi"
      },
      {
        "command": "devgotchi.chooseClass",
        "title": "Choose / Respec Class",
        "category": "DevGotchi"
      }
    ]
  }, "maintainers": [
    "John Facey"
  ],
    "repository": {
    "type": "git",
    "url": "https://github.com/johnfacey/vscode-devgotchi.git"
  },
    "keywords": ["pomodoro", "productivity", "gamification", "focus", "timer", "motivation", "tamagotchi", "achievements", "streak", "burnout", "rpg", "habit", "game", "deep work", "fun", "tamogotchi"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "package": "npx vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "eslint": "^8.47.0",
    "typescript": "^5.1.6"
  }
}